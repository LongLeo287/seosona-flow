{
  "schema": "seosona.build.generated-artifacts.v1",
  "note": "Registry of in-repo generated artifacts and their source-and-generator chain. Reproducible entries are byte-verified by scripts/build/check-generated.mjs. Non-reproducible legacy artifacts are explicit, owned deferrals.",
