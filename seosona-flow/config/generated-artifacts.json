    },
    {
      "artifact": "localization strings (loading-i18n / locale tables)",
      "reason": "Locale tables are edited inline; no single source-of-truth generator exists yet.",
      "owner": "UX and Accessibility Model",
      "risk": "low",
      "reviewTrigger": "Phase 8 design-token / i18n consolidation."
    }
  ]
}
