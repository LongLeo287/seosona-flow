      "checkCommand": "node scripts/build/render-page-scripts.mjs --check",
      "source": "extension HTML pages (script src order)"
    },
    {
      "artifact": "seosona-flow/artifacts/audit/phase-01/repository-inventory.json",
      "generator": "node scripts/audit/inventory.mjs",
      "checkCommand": "node scripts/audit/inventory.mjs --check",
      "source": "git ls-files tracked scope"
    },
    {
      "artifact": "seosona-flow/artifacts/audit/phase-01/message-contracts.json",
      "generator": "node scripts/audit/message-contracts.mjs",
      "checkCommand": "node scripts/audit/message-contracts.mjs --check",
      "source": "tracked JS message handlers"
    },
    {
      "artifact": "seosona-flow/artifacts/architecture/phase-04/globals.json",
      "generator": "node scripts/audit/global-dependencies.mjs",
      "checkCommand": "node scripts/audit/global-dependencies.mjs --check",
      "source": "tracked JS global reads/writes"
    }
  ],
  "deferred": [
    {
      "artifact": "src/prompts/* (prompt-pack data)",
      "reason": "Prompt-pack entries were authored and expanded by hand; the original generator and source corpus are not in-repo.",
