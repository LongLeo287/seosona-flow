{
  "schema": "seosona.release.package-allowlist.v1",
  "note": "Only tracked runtime files matching an include rule (and no exclude rule) ship in the extension package. Build tooling, tests, docs, and evidence are excluded.",
  "includePrefixes": [
    "seosona-flow/_locales/",
    "seosona-flow/assets/",
    "seosona-flow/content_scripts/",
    "seosona-flow/fonts/",
    "seosona-flow/icons/",
    "seosona-flow/images/",
    "seosona-flow/lib/",
    "seosona-flow/pages/",
    "seosona-flow/src/",
    "seosona-flow/styles/"
  ],
  "includeExact": [
    "seosona-flow/manifest.json",
    "seosona-flow/background.js",
    "seosona-flow/boot.js",
    "seosona-flow/watermark-worker.js"
  ],
  "excludePatterns": [
    "\\.test\\.mjs$",
    "\\.spec\\.mjs$",
    "/tests/",
    "/scripts/",
    "/artifacts/",
    "\\.md$",
    "package(-lock)?\\.json$",
    "\\.backup$",
    "\\.bak$",
    "seosona\\.project\\.json$"
  ]
}
