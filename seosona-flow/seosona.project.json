{
  "$schema": "~/.seosona/1_CONFIG/schemas/seosona.project.schema.json",
  "schema": "seosona.project.v1",
  "name": "seosona-flow",
  "displayName": "SEOSONA Flow",
  "domain": "software-project",
  "stack": [
    "browser-extension",
    "javascript"
  ],
  "osRoot": "~/.seosona",
  "memoryNamespace": "seosona-flow",
  "autonomy": {
    "defaultLevel": "project_edit",
    "requiresExplicitApproval": [
      "os_core_patch",
      "git_publish",
      "deploy"
    ]
  },
  "commands": {
    "doctor": "npm run seosona:doctor",
    "log": "npm run seosona:log"
  },
  "workflows": [
    "project-doctor",
    "portable-rule-sync",
    "project-memory-logging"
  ],
  "ruleFiles": [
    "AGENTS.md",
    ".clauderules",
    ".cursorrules"
  ]
}
