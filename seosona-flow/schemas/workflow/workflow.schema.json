{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seosona.workflow.v1",
  "title": "SEOSONA Flow Workflow",
  "description": "Documentation schema for a workflow document. Enforcement lives in src/workflow/WorkflowSchema.js (bounded, stable issue paths).",
  "type": "object",
  "required": ["name", "nodes"],
  "properties": {
    "id": { "type": ["number", "string"] },
    "name": { "type": "string", "maxLength": 200 },
    "slug": { "type": "string" },
    "description": { "type": "string" },
    "thumbnail_url": { "type": "string" },
    "video_url": { "type": "string" },
    "category_id": { "type": ["number", "null"] },
    "nodes": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "maxLength": 200 },
          "type": { "type": "string", "description": "image | generate | prompt | chatgpt | text | note (advisory; unknown allowed)" },
          "position": {
            "type": "object",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "data": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "description": "must reference an existing node id" },
          "target": { "type": "string", "description": "must reference an existing node id" },
          "sourceHandle": { "type": "string" },
          "targetHandle": { "type": "string" }
        }
      }
    }
  }
}
